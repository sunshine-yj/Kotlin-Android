<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/Theme.BookMarket">
        <activity
                android:name=".SplashActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity"/>

        <activity android:name=".MenuActivity"/>
        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="도서목록"
                  android:name=".BooksActivity"/>
        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="도서상세정보"
                  android:name=".BookActivity"/>
        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="장바구니"
                  android:name=".cart.CartActivity"/>
        
        <activity android:theme="@style/MyTheme.Cart"
                  android:label="배송정보"
                  android:name=".order.ShippingActivity"/>
        <activity android:theme="@style/MyTheme.Cart"
                  android:label="주문서"
                  android:name=".order.OrderActivity"/>

        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="나의 페이지"
                  android:name=".mypage.MyPageActivity"/>
        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="메모장"
                  android:name=".mypage.MemoActivity"/>

        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="마켓정보"
                  android:name=".marketinfo.MarketInfoActivity"/>

        <provider
            android:authorities="com.androidbook.bookmarket.mypage.fileprovider"
            android:name="androidx.core.content.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data android:name="com.google.android.geo.API_KEY"
                   android:value="AIzaSyBEAuGGYCBXGUt6j5IRt9ejj9HmnxjJj8U"/>

    </application>

</manifest>