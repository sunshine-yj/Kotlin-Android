<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/Theme.BookMarket">
        <activity
                android:name=".MainActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MenuActivity"/>
        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="도서목록"
                  android:name=".BooksActivity"/>
        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="도서상세정보"
                  android:name=".BookActivity"/>
        <activity android:theme="@style/MyTheme.BookMarket"
                  android:label="장바구니"
                  android:name=".cart.CartActivity"/>
        
        <activity android:theme="@style/MyTheme.Cart"
                  android:label="배송정보"
                  android:name=".order.ShippingActivity"/>
        <activity android:theme="@style/MyTheme.Cart"
                  android:label="주문서"
                  android:name=".order.OrderActivity"/>

    </application>

</manifest>